// D2: one Worker serves the three static files and proxies /api/* to Cloud Run.
// Deploy only with `npx --yes wrangler@4.145.0`, and after each deploy confirm that `/`
// answers a signed-out request with a 302 to Access (C7-1).
// The Worker's dependencies (C7-8: jose) live in worker/package.json; run
// `npm ci --prefix worker` before deploying or testing.
{
  "name": "finpo",
  "main": "./worker/index.js",
  // Checked against the installed wrangler when C7-1 first deploys; not yet verified.
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./src/stock_quote_fetcher/static/",
    // /api/* starts the Worker first; other paths are served from here, and only a path
    // with no matching file falls back to the Worker, which answers it 404.
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // The deterministic URL: WEB_ALLOWED_HOSTS admits only this host, so the legacy
    // stock-quote-nfmyvudecq-an.a.run.app is answered 403 (C6-2).
    "UPSTREAM_ORIGIN": "https://stock-quote-896096883650.asia-northeast1.run.app",
    // C7-8: the Access JWT's issuer, compared as an exact string, and where its keys are
    // published (/cdn-cgi/access/certs). A bare https origin: no trailing slash.
    "ACCESS_TEAM_DOMAIN": "https://khlin.cloudflareaccess.com",
    // C7-8: the Access application's audience tag. An identifier, not a secret: tokens are
    // trusted for Cloudflare's signature. Read from the `kid` of the Access login redirect
    // and confirmed by the user in the Zero Trust dashboard (2026-10-01).
    "ACCESS_AUD": "fa06f0350059e4038d2927c1e83ac81e01825cc7930609d12bbdf3e41980c065"
  }
  // PROXY_HMAC_SECRET is a secret, set with `wrangler secret put`, never written here.
  // It holds the same value as Secret Manager's proxy-hmac-secret (C1-7).
  // ACCESS_ALLOWED_EMAILS is a secret too (C7-8): comma-separated, compared without case.
  // The repository is public, so the list must not be written here.
}

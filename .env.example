# Template only. Do not put real credentials in this tracked file.
# These values will be injected by the execution environment at integration time.
# The CLI scaffold does not load .env automatically.
DB_PASSWORD=
FINNHUB_API_KEY=
# Required for stock-web, including local runs; at least 32 bytes of random secret.
# Cloud Run: map Secret Manager proxy-hmac-secret to PROXY_HMAC_SECRET.
# Optional previous key: map proxy-hmac-secret-prev to PROXY_HMAC_SECRET_PREV.
PROXY_HMAC_SECRET=
PROXY_HMAC_SECRET_PREV=

# C7-1: security headers for the three static files, applied by Workers static assets.
# Cloudflare reads this file and does not serve it. /api/* responses come through the
# Worker instead and carry the backend's own headers (worker/index.js).
#
# index.html has no inline script or style: app.js builds the chart with the DOM and sets
# colours through element.style, which style-src 'self' allows.
#
# Referrer-Policy is same-origin, not no-referrer: under no-referrer the Fetch spec sends
# `Origin: null` on same-origin POSTs, and the backend's Origin allowlist would refuse every
# write with 403 (C2-2). same-origin still sends no referrer to any other site.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
